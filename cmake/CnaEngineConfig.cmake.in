# SPDX-License-Identifier: MIT
@PACKAGE_INIT@

# CNA exports no CMake package (upstream-issues.md UP-001): a consumer adds
# its source tree (or otherwise defines its targets) BEFORE
# find_package(CnaEngine); this file verifies that they exist. cna-extended
# installs a package since 0.2.0: when CNA::Extended is not defined yet, it
# is looked up with find_package(CnaExtended).
set(CnaEngine_HAS_EXTENDED @CNA_ENGINE_PACKAGE_HAS_EXTENDED@)

# Every CNA target an exported engine target links (cna-extended aside).
set(_cna_engine_required_targets @CNA_ENGINE_PACKAGE_REQUIRED@)
set(_cna_engine_missing "")
foreach(_cna_engine_target IN LISTS _cna_engine_required_targets)
    if(NOT TARGET ${_cna_engine_target})
        list(APPEND _cna_engine_missing ${_cna_engine_target})
    endif()
endforeach()

# Components: Core, Graphics, App (strict); EnhancedGraphics, ExtendedIntegration (enhanced).
set(_cna_engine_wants_extended OFF)
if("ExtendedIntegration" IN_LIST CnaEngine_FIND_COMPONENTS)
    set(_cna_engine_wants_extended ON)
endif()
if(_cna_engine_wants_extended AND NOT CnaEngine_HAS_EXTENDED)
    set(CnaEngine_FOUND FALSE)
    set(CnaEngine_NOT_FOUND_MESSAGE
        "this CnaEngine installation was built without ExtendedIntegration (CNA_ENGINE_WITH_EXTENDED=OFF)")
    return()
endif()
if(CnaEngine_HAS_EXTENDED AND NOT TARGET CNA::Extended AND _cna_engine_wants_extended)
    # The exported ExtendedIntegration target names CNA::Extended: from the
    # consumer's cna-extended source tree, else from its installed package.
    find_package(CnaExtended @CNA_ENGINE_EXTENDED_PACKAGE_VERSION@ CONFIG QUIET)
    if(NOT TARGET CNA::Extended)
        list(APPEND _cna_engine_missing CNA::Extended)
    endif()
endif()

if(_cna_engine_missing)
    set(CnaEngine_FOUND FALSE)
    set(CnaEngine_NOT_FOUND_MESSAGE
        "define these targets before find_package(CnaEngine), e.g. by add_subdirectory() of the CNA/cna-extended source trees: ${_cna_engine_missing}")
    return()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/CnaEngineTargets.cmake")

# Re-attach the dependency links that cannot be exported.
@CNA_ENGINE_PACKAGE_LINK_LINES@
# cna_engine_add_game() (plan.md GAME-001) for installed consumers too.
include("${CMAKE_CURRENT_LIST_DIR}/CnaEngineGameFunctions.cmake")

foreach(_cna_engine_component IN LISTS CnaEngine_FIND_COMPONENTS)
    if(TARGET CnaEngine::${_cna_engine_component})
        set(CnaEngine_${_cna_engine_component}_FOUND TRUE)
    else()
        set(CnaEngine_${_cna_engine_component}_FOUND FALSE)
    endif()
endforeach()
check_required_components(CnaEngine)
